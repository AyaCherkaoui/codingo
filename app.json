{
  "expo": {
    "name": "Bracey",
    "slug": "bracey",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ayacherkaoui.bracey",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0d0a1f",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.ayacherkaoui.bracey"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "backgroundColor": "#0d0a1f",
      "name": "Bracey",
      "themeColor": "#7c5cff"
    },
    "plugins": [
      "expo-status-bar",
      "expo-audio",
      "expo-web-browser",
      ["expo-image-picker", { "photosPermission": "Bracey uses your photos so you can attach a screenshot to your feedback." }]
    ],
    "scheme": "bracey",
    "backgroundColor": "#0d0a1f",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0d0a1f"
    }
  }
}
